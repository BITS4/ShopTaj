    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.3.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
