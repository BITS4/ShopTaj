    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
