# ── Database (Railway auto-fills DATABASE_URL) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── App ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-web-app.vercel.app
BACKEND_URL=https://your-backend.railway.app

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Email (Gmail) ──────────────────────────────────────────────────────────
GMAIL_USER=shoptaj.noreply@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM=ShopTaj <shoptaj.noreply@gmail.com>

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary (optional — local uploads used if not set) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp Business (Meta Cloud API) ─────────────────────────────────────
# Get these from: Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Required message templates (create in Meta Business Manager):
#   shoptaj_otp            — authentication, body: "Ваш код подтверждения ShopTaj — {{1}}. Действителен 10 минут."
#   shoptaj_order_confirmation — utility, body: "Ваш заказ ShopTaj #{{1}} принят. Сумма: {{2}}. Спасибо!"
#   shoptaj_order_status   — utility, body: "Статус вашего заказа ShopTaj #{{1}} обновлён — {{2}}."

# ── bePaid (optional — for future Korti Milli API integration) ─────────────
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_TEST_MODE=false
BEPAID_CURRENCY=USD
