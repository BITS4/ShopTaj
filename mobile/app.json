{
  "expo": {
    "name": "ShopTaj",
    "slug": "shoptaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.shoptaj.app" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#6366f1" },
      "package": "com.shoptaj.app"
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-notifications",
      ["expo-splash-screen", { "image": "./assets/splash.png", "backgroundColor": "#6366f1" }]
    ],
    "scheme": "shoptaj",
    "extra": {
      "apiUrl": "http://localhost:3001/api",
      "stripePk": "pk_test_your_key"
    }
  }
}
