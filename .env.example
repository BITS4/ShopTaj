# ShopTaj environment catalog
# Copy to backend/.env and web/.env.local for local development. Each app
# ignores variables it does not use. Never commit populated environment files.

# Core infrastructure
DATABASE_URL=postgresql://shoptaj:shoptaj_pass@localhost:5432/shoptaj_db
REDIS_URL=redis://localhost:6379

# API runtime
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Automated tests mock external providers; this flag also lets future adapters
# opt into deterministic local fakes.
TEST_MODE=false

# Authentication (replace with long random values outside local development)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Web application
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DOMAIN=localhost:3000
NEXT_PUBLIC_STRIPE_PK=pk_test_replace_with_your_publishable_key
# Vercel supplies this automatically in hosted environments. Keep it host-only.
VERCEL_URL=localhost:3000

# Expo mobile client
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# Set this to the development computer's LAN address for a physical device.
EXPO_PUBLIC_DEV_HOST=

# Stripe payments
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# Cloudinary (optional; local uploads are used when these are blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional; verification codes are logged locally when unconfigured)
# Configure either Gmail or Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# WhatsApp Business notifications (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# bePaid checkout (optional)
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_TEST_MODE=true
BEPAID_CURRENCY=USD

# Error tracking (optional; leave blank to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
